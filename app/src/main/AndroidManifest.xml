<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.audio.low_latency" android:required="false" />
    <uses-feature android:name="android.hardware.audio.pro" android:required="false" />

    <!-- Buat fitur "LOAD ONLINE" - ambil daftar & download file preset .zip dari
         repo GitHub publik (lihat OnlinePresetRepo.kt). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Buat dialog "Pilih Lagu" - scan musik yang sudah kedeteksi di HP lewat
         MediaStore (lihat MusicLibraryRepo.kt). READ_MEDIA_AUDIO dipakai di
         Android 13+ (API 33+), READ_EXTERNAL_STORAGE buat versi di bawahnya
         (maxSdkVersion 32 biar gak diminta lagi di device yang udah pakai
         READ_MEDIA_AUDIO). Kalau user nolak izin ini, dialog tetap kebuka
         cuma daftarnya kosong - opsi "Cari File Manual" (SAF, gak butuh izin
         ini) tetap selalu bisa dipakai. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Buat fitur REKAM LAYAR (ScreenRecordService.kt): capture video lewat
         MediaProjection + audio dari buffer PCM internal (BUKAN AudioPlaybackCapture),
         dimux jadi MP4. FOREGROUND_SERVICE_MEDIA_PROJECTION wajib ada dari Android 14
         (API 34) ke atas biar startForeground(..., FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION)
         gak ditolak sistem. POST_NOTIFICATIONS wajib dari Android 13 (API 33) biar
         notifikasi foreground service-nya kelihatan (tanpa ini service tetap jalan,
         cuma notifikasinya yang gak tampil di beberapa OEM). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:largeHeap="true"
        tools:replace="android:label">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service buat fitur rekam layar - lihat ScreenRecordService.kt
             untuk alur lengkapnya (MediaProjection+VirtualDisplay+MediaCodec video,
             PCM internal app+MediaCodec audio, dimux ke MP4 lewat MediaMuxer). -->
        <service
            android:name=".ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
